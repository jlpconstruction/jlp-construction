# Copy this file to `.env` and fill in the real values from
# Supabase → Project Settings → API. `.env` is gitignored: never commit it.
#
# Only the *public* anon key goes here. It is safe in the browser because
# Row Level Security protects the data. NEVER put the service_role key,
# the Anthropic key, or the Resend key in any VITE_ variable: everything
# prefixed with VITE_ ends up in the public JavaScript bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile (the spam check on the request form): the *site key*, which is public.
# Its secret key goes in Supabase → Edge Functions → Secrets as TURNSTILE_SECRET_KEY, never here.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# AI project brief on Jorge's request page: set to on once Anthropic credits are added
# (the Anthropic key itself lives only in Supabase secrets, never here).
VITE_AI_BRIEF=off
